#!/usr/bin/env python3
##########################################################################################
## agent-flick — tool-call/cost observer for llm-snitch.
##
## Thin wrapper around `agent-strace` (https://github.com/Siddhant-K-code/agent-trace,
## MIT, PyPI `agent-strace`, pinned 0.83.0, stdlib-only). agent-strace captures the
## agent's SEMANTIC layer via Claude Code hooks: tool-call intent, results, latency,
## tokens/cost — the layer fs-coil's syscall view can't see. This wrapper's only
## original job is the cost / tool-fail-rate ALERT BRIDGE into llm-snitch's
## terminal-notifier channel, edge-triggered. Everything else is `exec agent-strace`.
##
## OBSERVATION ONLY: enforcement stays with firewall-constrictor. The upstream `watch`
## kill-switch is deliberately not wired (plans/siddhant-agent-trace-integration.md C3).
## Runs as the USER, never root. Shared scaffolding lives in fs_coil/bridge.py.
##
## Usage:
##   agent-flick                  list recorded sessions (exec agent-strace list)
##   agent-flick check            cost/fail-rate gate over recorded sessions;
##                                  alert on healthy->breach transition
##                                  exit 0 pass / 1 breach / 2 operational-error
##   agent-flick alerts           tail the gate-alert log
##   agent-flick <args...>        passthrough to agent-strace (replay, stats, ...)
##########################################################################################

import json
import os
import re
import shutil
import subprocess
import sys
from datetime import datetime
from pathlib import Path

# C1 belt-and-braces: every wrapper-mediated agent-strace invocation runs with
# telemetry off. The PRIMARY control is the persisted opt-out written at install
# (`agent-strace telemetry disable` -> ~/.agent-strace/telemetry.json), which
# also covers the hook-path invocations that never pass through this wrapper.
os.environ.setdefault("DO_NOT_TRACK", "1")
os.environ.setdefault("AGENT_STRACE_TELEMETRY", "0")

# Resolve the fs_coil package (for bridge/Notifier/theme reuse) — same
# candidate search as src/fs-coil.
_HERE = os.path.dirname(os.path.realpath(__file__))
for _c in (_HERE, "/usr/local/share/llm-snitch"):
    if os.path.isdir(os.path.join(_c, "fs_coil")):
        if _c not in sys.path:
            sys.path.insert(0, _c)
        break

from fs_coil import bridge                        # noqa: E402
from fs_coil.notifier import Notifier             # noqa: E402
from fs_coil.theme import err, warn               # noqa: E402

# Pinned upstream — see plans/siddhant-agent-trace-integration.md.
PINNED_VERSION = "0.83.0"

AGENT_STRACE_BIN = bridge.resolve_bin([
    shutil.which("agent-strace"),
    os.path.expanduser("~/.local/bin/agent-strace"),
    "/opt/homebrew/bin/agent-strace",
    "/usr/local/bin/agent-strace",
])

_DEFAULTS = {
    "cost_ceiling": 5.0,        # dollars per session (agent-strace estimate)
    "max_tool_fail_rate": 15.0, # percent: errors / tool_calls
    "range": "latest",          # latest | today | all
}

EXIT_PASS, EXIT_BREACH, EXIT_OPERATIONAL = (
    bridge.EXIT_PASS, bridge.EXIT_BREACH, bridge.EXIT_OPERATIONAL)

# `agent-strace cost` has no JSON output; this matches cost.py's format_cost
# line. Tier-2's contract canary catches upstream format drift.
_COST_RE = re.compile(r"Estimated cost: \$([0-9.]+)")


def _state_dir():
    return bridge.state_dir("agent-flick")


def load_cfg():
    """Read [agent-flick] from ~/.config/llm-snitch/config (INI)."""
    return bridge.load_section(
        "agent-flick", _DEFAULTS,
        {"cost_ceiling": float, "max_tool_fail_rate": float},
    )


def _require_bin():
    if AGENT_STRACE_BIN is None:
        err("agent-strace not installed — run ./install.sh or: "
            f"pip3 install --user agent-strace=={PINNED_VERSION}")
        return False
    return True


def _traces_dir():
    """agent-strace stores sessions in .agent-traces/ relative to where the
    hooks ran (usually the project dir) — check cwd first, then home."""
    for d in (Path.cwd() / ".agent-traces", Path.home() / ".agent-traces"):
        if d.is_dir():
            return d
    return None


def _sessions(tdir, rng):
    """Session meta dicts for the range, newest first. Corrupt/in-progress
    meta.json files are skipped, never fatal. Covers both the flat and the
    workspaces/<id>/ layouts."""
    metas = []
    for p in list(tdir.glob("*/meta.json")) + list(tdir.glob("workspaces/*/*/meta.json")):
        try:
            m = json.loads(p.read_text())
        except (OSError, json.JSONDecodeError):
            continue
        if isinstance(m, dict):
            m["_mtime"] = p.stat().st_mtime
            metas.append(m)
    metas.sort(key=lambda m: m.get("started_at") or m["_mtime"], reverse=True)
    if rng == "today":
        midnight = datetime.now().replace(hour=0, minute=0, second=0,
                                          microsecond=0).timestamp()
        return [m for m in metas if (m.get("started_at") or m["_mtime"]) >= midnight]
    if rng == "all":
        return metas
    return metas[:1]   # latest (default)


def _session_cost(session_id, tdir):
    """Dollar estimate via `agent-strace cost <id>` (offline pricing math in
    the upstream, no network). --trace-dir is explicit because the upstream
    default is cwd-relative. None when unavailable — the fail-rate check
    still runs; cost drift is caught by the Tier-2 canary."""
    if not session_id:
        return None
    try:
        proc = subprocess.run([AGENT_STRACE_BIN, "--trace-dir", str(tdir),
                               "cost", str(session_id)],
                              capture_output=True, text=True, timeout=60)
    except (subprocess.TimeoutExpired, OSError):
        return None
    m = _COST_RE.search(proc.stdout or "")
    return float(m.group(1)) if m else None


def cmd_check(cfg):
    if not _require_bin():
        return EXIT_OPERATIONAL
    tdir = _traces_dir()
    if tdir is None:
        err("no .agent-traces/ found (cwd or ~) — record a session first, "
            "or run `agent-strace setup` from a plain terminal")
        return EXIT_OPERATIONAL
    metas = _sessions(tdir, cfg["range"])
    if not metas:
        err(f"no readable sessions in {tdir} (range={cfg['range']})")
        return EXIT_OPERATIONAL

    # AGGREGATES ONLY — session id / counts / dollars. Never meta['command'],
    # never event bodies: prompts and tool args must not enter llm-snitch logs.
    breaches = []
    for m in metas:
        sid = str(m.get("session_id") or "?")
        calls = int(m.get("tool_calls") or 0)
        errors = int(m.get("errors") or 0)
        rate = round(errors * 100.0 / calls, 1) if calls else 0.0
        cost = _session_cost(m.get("session_id"), tdir)
        reasons = []
        if cost is not None and cost > cfg["cost_ceiling"]:
            reasons.append(f"cost ${cost:.2f} > ${cfg['cost_ceiling']:.2f}")
        if rate > cfg["max_tool_fail_rate"]:
            reasons.append(f"tool-fail {rate}% > {cfg['max_tool_fail_rate']}%")
        if reasons:
            breaches.append(f"session {sid[:12]}: {', '.join(reasons)} "
                            f"(tools {calls}, errors {errors}, "
                            f"tokens {int(m.get('total_tokens') or 0)})")

    verdict = "breach" if breaches else "pass"
    ts = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    sdir = _state_dir()
    log = sdir / "alerts.log"

    def _on_breach():
        msg = " | ".join(breaches)
        bridge.secure_write(log, f"[{ts}] BREACH {msg}\n", mode="a")
        Notifier().notify(
            title="🦍 agent-flick: session threshold breached",
            message=msg,
            key=("agent-flick", "gate", "breach"),
        )

    def _on_recover():
        bridge.secure_write(log, f"[{ts}] RECOVERED sessions back under thresholds\n",
                            mode="a")

    bridge.edge_alert(sdir / "state.json", verdict, _on_breach, _on_recover)
    return EXIT_PASS if verdict == "pass" else EXIT_BREACH


def cmd_alerts():
    log = _state_dir() / "alerts.log"
    if not log.exists():
        warn(f"no alerts yet at {log}")
        return
    try:
        subprocess.run(["/usr/bin/tail", "-n", "200", str(log)])
    except (KeyboardInterrupt, OSError):
        pass


def main():
    argv = sys.argv[1:]
    cmd = argv[0] if argv else ""

    if cmd == "check":
        sys.exit(cmd_check(load_cfg()))
    if cmd == "alerts":
        cmd_alerts()
        return
    if not _require_bin():
        sys.exit(EXIT_OPERATIONAL)
    # Default: session list. Any other args: raw passthrough to agent-strace.
    passthrough = argv if argv else ["list"]
    os.execv(AGENT_STRACE_BIN, [AGENT_STRACE_BIN] + passthrough)


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        sys.exit(130)
